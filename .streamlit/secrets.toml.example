# ÖRNEK - Bu dosyayı secrets.toml olarak kopyalayın ve kendi anahtarlarınızı girin.
# secrets.toml asla commit edilmez (.gitignore ile dışlanır).
# Tüm servisler opsiyoneldir; anahtar olmadan uygulama çalışır.

[finnhub]
# https://finnhub.io/register -> Dashboard > API Key
api_key = ""

[gemini]
# https://aistudio.google.com/app/api-keys
api_key = ""
model = "gemini-3.1-flash-lite"

[alpaca_paper]
# Yalnızca paper (test) ortamı. Canlı endpoint kullanılmaz.
key_id = ""
secret_key = ""
base_url = "https://paper-api.alpaca.markets/v2"

# UYARI: GERÇEK PARA. Yalnızca yasal/broker önkoşulları tamamlandıktan ve
# config.yaml live_trading.enabled = true yapıldıktan sonra doldurun.
# Anahtarları asla depoya veya OneDrive klasörüne koymayın.
[alpaca_live]
key_id = ""
secret_key = ""
base_url = "https://api.alpaca.markets/v2"

# Binance: ONCE testnet.binance.vision adresinden API anahtari uretin (sanal para).
# Gercek anahtari asla buraya yapistirmayin; perakende canli islem risklidir.
# Paracikirma (withdraw) izni VERMEYIN, IP kisitlamasi kullanin.
[binance]
api_key = ""
secret_key = ""

# Gate.io testnet: https://www.gate.io/testnet -> API Keys
[gateio]
key = ""
secret = ""

# Binance TR (ayri borsa; global Binance'den farkli API)
[binance_tr]
api_key = ""
secret_key = ""

[twilio]
# https://console.twilio.com/
account_sid = ""
auth_token = ""
from_number = ""

[smtp]
# Gmail için normal şifre değil, 16 haneli "Uygulama Şifresi" kullanın.
host = "smtp.gmail.com"
port = "587"
user = ""
password = ""
to = ""

[inngest]
# https://app.inngest.com/ -> environment settings
signing_key = ""
event_key = ""

[alerts]
# Uygulama içindeki "Anahtarları tarayıcıdan düzenle" paneli bu bölümü yazar.
telegram_bot_token = ""
telegram_chat_id = ""
ntfy_topic = ""
